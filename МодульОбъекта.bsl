#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультат()
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("ЕстьОшибки", Ложь);
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("ДокументыРезервирования", Новый Массив);
	Результат.Вставить("ДокументыСписания", Новый Массив);
	Результат.Вставить("ДокументыОприходования", Новый Массив);
	Результат.Вставить("КоличествоРезервов", 0);
	Результат.Вставить("КоличествоОстатков", 0);
	Результат.Вставить("КоличествоОтрицательных", 0);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСообщение(Результат, Текст, ЭтоОшибка = Ложь)
	
	Результат.Сообщения.Добавить(Текст);
	Если ЭтоОшибка Тогда
		Результат.ЕстьОшибки = Истина;
	КонецЕсли;
	ОбщегоНазначения.СообщитьПользователю(Текст);
	
КонецПроцедуры

Процедура ПроверитьПараметры(ПараметрыОбнуления, Результат)
	
	Если Не ЗначениеЗаполнено(ПараметрыОбнуления.Организация) Тогда
		ДобавитьСообщение(Результат, "Не указана организация.", Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыОбнуления.Склад) Тогда
		ДобавитьСообщение(Результат, "Не указан склад.", Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыОбнуления.Дата) Тогда
		ПараметрыОбнуления.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ПараметрыОбнуления.СписыватьОстатки
		И Не ЗначениеЗаполнено(ПараметрыОбнуления.Корреспонденция) Тогда
		ДобавитьСообщение(Результат,
			"Для списания остатков укажите счет корреспонденции (тип «Прочие расходы»).", Истина);
	КонецЕсли;
	
	Если Не ПараметрыОбнуления.СниматьРезервы И Не ПараметрыОбнуления.СписыватьОстатки Тогда
		ДобавитьСообщение(Результат, "Не выбран ни один режим: снятие резервов / списание остатков.", Истина);
	КонецЕсли;
	
КонецПроцедуры

#Область СнятиеРезервов

Процедура СнятьРезервы(ПараметрыОбнуления, Результат)
	
	ТаблицаРезервов = ПолучитьРезервы(
		ПараметрыОбнуления.Организация,
		ПараметрыОбнуления.Склад,
		ПараметрыОбнуления.Дата);
	
	Результат.КоличествоРезервов = ТаблицаРезервов.Количество();
	
	Если ТаблицаРезервов.Количество() = 0 Тогда
		ДобавитьСообщение(Результат, "Резервы по выбранным организации и складу не найдены.");
		Возврат;
	КонецЕсли;
	
	ДобавитьСообщение(Результат,
		СтрШаблон("Найдено строк резерва: %1. Формируются документы снятия резерва...",
			ТаблицаРезервов.Количество()));
	
	// Группируем по заказу покупателя — один документ на заказ
	ТаблицаЗаказов = ТаблицаРезервов.Скопировать();
	ТаблицаЗаказов.Свернуть("ЗаказПокупателя");
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		
		Отбор = Новый Структура("ЗаказПокупателя", СтрокаЗаказа.ЗаказПокупателя);
		СтрокиЗаказа = ТаблицаРезервов.НайтиСтроки(Отбор);
		
		Попытка
			ДокументСсылка = СоздатьДокументСнятияРезерва(
				ПараметрыОбнуления,
				СтрокаЗаказа.ЗаказПокупателя,
				СтрокиЗаказа);
			
			Результат.ДокументыРезервирования.Добавить(ДокументСсылка);
			ДобавитьСообщение(Результат,
				СтрШаблон("Создан документ снятия резерва: %1", ДокументСсылка));
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ДобавитьСообщение(Результат,
				СтрШаблон("Ошибка снятия резерва по заказу %1: %2",
					СтрокаЗаказа.ЗаказПокупателя,
					ТекстОшибки),
				Истина);
			
			Если ЭтоКонфликтБлокировок(ТекстОшибки) Тогда
				ДобавитьСообщение(Результат,
					"Закройте открытые заказы покупателей и документы по этому складу у всех пользователей, затем повторите.");
			КонецЕсли;
		КонецПопытки;
		
		// Пауза между заказами — снижает конфликт блокировок регистров
		ПаузаМс(300);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьДокументСнятияРезерва(ПараметрыОбнуления, ЗаказПокупателя, СтрокиЗаказа)
	
	ДокументОбъект = Документы.РезервированиеЗапасов.СоздатьДокумент();
	ДокументОбъект.Дата = ПараметрыОбнуления.Дата;
	ДокументОбъект.Организация = ПараметрыОбнуления.Организация;
	ДокументОбъект.ЗаказПокупателя = ЗаказПокупателя;
	ДокументОбъект.Комментарий = "Автоматическое снятие резерва (обнуление склада)";
	
	УстановитьВидОперацииСнятияРезерва(ДокументОбъект);
	
	МетаданныеТЧ = ДокументОбъект.Метаданные().ТабличныеЧасти.Запасы;
	ЕстьИсходноеМесто = МетаданныеТЧ.Реквизиты.Найти("ИсходноеМесто") <> Неопределено;
	ЕстьИсходноеМестоРезерва = МетаданныеТЧ.Реквизиты.Найти("ИсходноеМестоРезерва") <> Неопределено;
	ЕстьСтруктурнаяЕдиница = МетаданныеТЧ.Реквизиты.Найти("СтруктурнаяЕдиница") <> Неопределено;
	ЕстьСклад = МетаданныеТЧ.Реквизиты.Найти("Склад") <> Неопределено;
	ЕстьЕдиницаИзмерения = МетаданныеТЧ.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	
	// Склад в шапке документа (если есть такой реквизит)
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("Склад") <> Неопределено Тогда
		ДокументОбъект.Склад = ПараметрыОбнуления.Склад;
	КонецЕсли;
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("СтруктурнаяЕдиница") <> Неопределено Тогда
		ДокументОбъект.СтруктурнаяЕдиница = ПараметрыОбнуления.Склад;
	КонецЕсли;
	
	Для Каждого СтрокаРезерва Из СтрокиЗаказа Цикл
		
		СтрокиКДобавлению = РазвернутьСтрокуПоХарактеристикам(
			СтрокаРезерва.Номенклатура,
			СтрокаРезерва.Характеристика,
			СтрокаРезерва.Партия,
			СтрокаРезерва.Количество,
			ПараметрыОбнуления.Организация,
			ПараметрыОбнуления.Склад,
			ЗаказПокупателя,
			ПараметрыОбнуления.Дата,
			Истина);
		
		Для Каждого СтрокаКДобавлению Из СтрокиКДобавлению Цикл
			
			НоваяСтрока = ДокументОбъект.Запасы.Добавить();
			НоваяСтрока.Номенклатура = СтрокаКДобавлению.Номенклатура;
			НоваяСтрока.Характеристика = СтрокаКДобавлению.Характеристика;
			НоваяСтрока.Партия = СтрокаКДобавлению.Партия;
			НоваяСтрока.Количество = СтрокаКДобавлению.Количество;
			
			Если ЕстьЕдиницаИзмерения Тогда
				НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					СтрокаКДобавлению.Номенклатура, "ЕдиницаИзмерения");
			КонецЕсли;
			
			// УНФ 3.0.12+: исходное место резерва (склад, с которого снимаем)
			Если ЕстьИсходноеМестоРезерва Тогда
				НоваяСтрока.ИсходноеМестоРезерва = ПараметрыОбнуления.Склад;
			КонецЕсли;
			
			Если ЕстьСклад Тогда
				НоваяСтрока.Склад = ПараметрыОбнуления.Склад;
			КонецЕсли;
			
			Если ЕстьИсходноеМесто Тогда
				НоваяСтрока.ИсходноеМесто = ПараметрыОбнуления.Склад;
				Если МетаданныеТЧ.Реквизиты.Найти("НовоеМесто") <> Неопределено Тогда
					НоваяСтрока.НовоеМесто = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			Если МетаданныеТЧ.Реквизиты.Найти("НовоеМестоРезерва") <> Неопределено Тогда
				НоваяСтрока.НовоеМестоРезерва = Неопределено;
			КонецЕсли;
			
			Если ЕстьСтруктурнаяЕдиница Тогда
				НоваяСтрока.СтруктурнаяЕдиница = ПараметрыОбнуления.Склад;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Запись);
	
	НужноПровести = ПараметрыОбнуления.ПроводитьДокументы
		Или ПараметрыОбнуления.СписыватьОстатки;
	
	Если НужноПровести Тогда
		// Перечитываем перед проведением — короче держим блокировки
		ДокументОбъект = ДокументОбъект.Ссылка.ПолучитьОбъект();
		ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

Процедура УстановитьВидОперацииСнятияРезерва(ДокументОбъект)
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	РеквизитВидОперации = МетаданныеДокумента.Реквизиты.Найти("ВидОперации");
	Если РеквизитВидОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// УНФ 3.0.12+: перечисление видов операций резервирования
	Попытка
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРезервированиеЗапасов.СнятиеРезерва;
		Возврат;
	Исключение
	КонецПопытки;
	
	Попытка
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРезервированиеЗапасов.СнятьРезерв;
		Возврат;
	Исключение
	КонецПопытки;
	
	// Перебор значений перечисления по представлению
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.ВидыОперацийРезервированиеЗапасов.ЗначенияПеречисления Цикл
		Имя = ВРег(ЗначениеПеречисления.Имя);
		Если СтрНайти(Имя, "СНЯТ") > 0 Или СтрНайти(Имя, "СНИМ") > 0 Тогда
			ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийРезервированиеЗапасов[ЗначениеПеречисления.Имя];
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СписаниеОстатков

Процедура СписатьОстатки(ПараметрыОбнуления, Результат)
	
	// После снятия резервов свободные остатки включают бывший резерв.
	// Берём управленческие остатки по организации+складу без заказа.
	ТаблицаОстатков = ПолучитьСвободныеОстатки(
		ПараметрыОбнуления.Организация,
		ПараметрыОбнуления.Склад,
		ПараметрыОбнуления.Дата);
	
	// Дополняем ячейками из складского регистра (если ведётся учёт по ячейкам)
	ТаблицаСкладских = ПолучитьОстаткиНаСкладах(ПараметрыОбнуления.Склад, ПараметрыОбнуления.Дата);
	КартаЯчеек = Новый Соответствие;
	Для Каждого СтрокаСклада Из ТаблицаСкладских Цикл
		Ключ = КлючНоменклатуры(СтрокаСклада.Номенклатура, СтрокаСклада.Характеристика, СтрокаСклада.Партия);
		Если КартаЯчеек.Получить(Ключ) = Неопределено И ЗначениеЗаполнено(СтрокаСклада.Ячейка) Тогда
			КартаЯчеек.Вставить(Ключ, СтрокаСклада.Ячейка);
		КонецЕсли;
	КонецЦикла;
	
	Результат.КоличествоОстатков = ТаблицаОстатков.Количество();
	
	Если ТаблицаОстатков.Количество() = 0 Тогда
		ДобавитьСообщение(Результат, "Свободные остатки по выбранным организации и складу не найдены.");
		Возврат;
	КонецЕсли;
	
	ДобавитьСообщение(Результат,
		СтрШаблон("Найдено строк остатков: %1. Формируются документы списания...",
			ТаблицаОстатков.Количество()));
	
	Лимит = ПараметрыОбнуления.ЛимитСтрокВДокументе;
	Если Лимит <= 0 Тогда
		Лимит = 500;
	КонецЕсли;
	
	ПакетСтрок = Новый Массив;
	Счетчик = 0;
	
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		
		ПакетСтрок.Добавить(СтрокаОстатка);
		Счетчик = Счетчик + 1;
		
		Если Счетчик >= Лимит Тогда
			ЗаписатьПакетСписания(ПараметрыОбнуления, ПакетСтрок, КартаЯчеек, Результат);
			ПакетСтрок.Очистить();
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПакетСтрок.Количество() > 0 Тогда
		ЗаписатьПакетСписания(ПараметрыОбнуления, ПакетСтрок, КартаЯчеек, Результат);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьПакетСписания(ПараметрыОбнуления, ПакетСтрок, КартаЯчеек, Результат)
	
	Попытка
		ДокументСсылка = СоздатьДокументСписания(ПараметрыОбнуления, ПакетСтрок, КартаЯчеек);
		Результат.ДокументыСписания.Добавить(ДокументСсылка);
		ДобавитьСообщение(Результат,
			СтрШаблон("Создан документ списания: %1 (%2 стр.)", ДокументСсылка, ПакетСтрок.Количество()));
	Исключение
		ДобавитьСообщение(Результат,
			СтрШаблон("Ошибка создания списания: %1",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			Истина);
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьДокументСписания(ПараметрыОбнуления, ПакетСтрок, КартаЯчеек)
	
	ДокументОбъект = Документы.СписаниеЗапасов.СоздатьДокумент();
	ДокументОбъект.Дата = ПараметрыОбнуления.Дата;
	ДокументОбъект.Организация = ПараметрыОбнуления.Организация;
	ДокументОбъект.СтруктурнаяЕдиница = ПараметрыОбнуления.Склад;
	ДокументОбъект.Корреспонденция = ПараметрыОбнуления.Корреспонденция;
	ДокументОбъект.Комментарий = "Автоматическое обнуление остатков на складе";
	
	МетаданныеТЧ = ДокументОбъект.Метаданные().ТабличныеЧасти.Запасы;
	ЕстьЯчейка = МетаданныеТЧ.Реквизиты.Найти("Ячейка") <> Неопределено;
	ЕстьЕдиницаИзмерения = МетаданныеТЧ.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	ЕстьСчетУчета = МетаданныеТЧ.Реквизиты.Найти("СчетУчета") <> Неопределено;
	НуженПропускПроверкиХарактеристики = Ложь;
	
	// Строки строго по измерениям остатка — без подмены характеристик
	Для Каждого СтрокаОстатка Из ПакетСтрок Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаОстатка.Характеристика)
			И НоменклатураТребуетХарактеристику(СтрокаОстатка.Номенклатура) Тогда
			НуженПропускПроверкиХарактеристики = Истина;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОстатка.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаОстатка.Характеристика;
		НоваяСтрока.Партия = СтрокаОстатка.Партия;
		НоваяСтрока.Количество = СтрокаОстатка.Количество;
		
		Если ЕстьЕдиницаИзмерения Тогда
			НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				СтрокаОстатка.Номенклатура, "ЕдиницаИзмерения");
		КонецЕсли;
		
		Если ЕстьСчетУчета Тогда
			СчетУчета = Неопределено;
			Попытка
				СчетУчета = СтрокаОстатка.СчетУчета;
			Исключение
			КонецПопытки;
			Если Не ЗначениеЗаполнено(СчетУчета) Тогда
				СчетУчета = СчетУчетаНоменклатуры(СтрокаОстатка.Номенклатура);
			КонецЕсли;
			Если ЗначениеЗаполнено(СчетУчета) Тогда
				НоваяСтрока.СчетУчета = СчетУчета;
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьЯчейка Тогда
			Ключ = КлючНоменклатуры(
				СтрокаОстатка.Номенклатура,
				СтрокаОстатка.Характеристика,
				СтрокаОстатка.Партия);
			Ячейка = КартаЯчеек.Получить(Ключ);
			Если Ячейка <> Неопределено Тогда
				НоваяСтрока.Ячейка = Ячейка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьДокументСписанияСПроверкой(ДокументОбъект, ПараметрыОбнуления, НуженПропускПроверкиХарактеристики);
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

Процедура ЗаписатьДокументСписанияСПроверкой(ДокументОбъект, ПараметрыОбнуления, НуженПропускПроверкиХарактеристики)
	
	ОтключенныеПроверки = Новый Массив;
	
	Если НуженПропускПроверкиХарактеристики Тогда
		ДокументОбъект.Комментарий = СокрЛП(ДокументОбъект.Комментарий)
			+ " [списание остатка без характеристики]";
		ОтключенныеПроверки = ОтключитьПроверкуХарактеристикВНоменклатуре(ДокументОбъект);
	КонецЕсли;
	
	Попытка
		
		ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Запись);
		
		Если ПараметрыОбнуления.ПроводитьДокументы Тогда
			ДокументОбъект = ДокументОбъект.Ссылка.ПолучитьОбъект();
			ДокументОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьКонтрольОстатков", Истина);
			ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольОстатков", Истина);
			ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
	Исключение
		ВосстановитьПроверкуХарактеристикВНоменклатуре(ОтключенныеПроверки);
		ВызватьИсключение;
	КонецПопытки;
	
	ВосстановитьПроверкуХарактеристикВНоменклатуре(ОтключенныеПроверки);
	
КонецПроцедуры

// Временно снимает флаги обязательности характеристики у номенклатуры в ТЧ документа.
// Возвращает массив структур для восстановления.
//
Функция ОтключитьПроверкуХарактеристикВНоменклатуре(ДокументОбъект)
	
	Результат = Новый Массив;
	Обработанные = Новый Соответствие;
	
	ИменаФлагов = Новый Массив;
	ИменаФлагов.Добавить("ПроверятьЗаполнениеХарактеристики");
	ИменаФлагов.Добавить("ОбязательноеЗаполнениеХарактеристики");
	ИменаФлагов.Добавить("ИспользоватьХарактеристики");
	
	МетаРеквизиты = Метаданные.Справочники.Номенклатура.Реквизиты;
	
	Для Каждого СтрокаЗапаса Из ДокументОбъект.Запасы Цикл
		
		Если ЗначениеЗаполнено(СтрокаЗапаса.Характеристика) Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = СтрокаЗапаса.Номенклатура;
		Если Не ЗначениеЗаполнено(Номенклатура) Или Обработанные.Получить(Номенклатура) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Номенклатура, Истина);
		
		Если Не НоменклатураТребуетХарактеристику(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
		БылиИзменения = Ложь;
		СохранённыеЗначения = Новый Структура;
		СохранённыеЗначения.Вставить("Номенклатура", Номенклатура);
		СохранённыеЗначения.Вставить("Флаги", Новый Структура);
		
		Для Каждого ИмяФлага Из ИменаФлагов Цикл
			Если МетаРеквизиты.Найти(ИмяФлага) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтароеЗначение = НоменклатураОбъект[ИмяФлага];
			СохранённыеЗначения.Флаги.Вставить(ИмяФлага, СтароеЗначение);
			Если СтароеЗначение = Истина Тогда
				НоменклатураОбъект[ИмяФлага] = Ложь;
				БылиИзменения = Истина;
			ИначеЕсли Строка(СтароеЗначение) = "Да" Тогда
				Попытка
					НоменклатураОбъект[ИмяФлага] = Перечисления.ДаНет.Нет;
				Исключение
					НоменклатураОбъект[ИмяФлага] = Ложь;
				КонецПопытки;
				БылиИзменения = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если БылиИзменения Тогда
			НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
			НоменклатураОбъект.Записать();
			Результат.Добавить(СохранённыеЗначения);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ВосстановитьПроверкуХарактеристикВНоменклатуре(ОтключенныеПроверки)
	
	Для Каждого Описание Из ОтключенныеПроверки Цикл
		
		Попытка
			НоменклатураОбъект = Описание.Номенклатура.ПолучитьОбъект();
			Для Каждого КлючИЗначение Из Описание.Флаги Цикл
				НоменклатураОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
			НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
			НоменклатураОбъект.Записать();
		Исключение
			// не прерываем основную ошибку списания
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КлючНоменклатуры(Номенклатура, Характеристика, Партия)
	
	Возврат Строка(Номенклатура.УникальныйИдентификатор())
		+ "|" + Строка(Характеристика.УникальныйИдентификатор())
		+ "|" + Строка(Партия.УникальныйИдентификатор());
	
КонецФункции

#КонецОбласти

#Область КорректировкаРегистровОбнуление

Процедура ОбнулитьОстаткиКорректировкойРегистров(ПараметрыОбнуления, Результат)
	
	ИмяДокумента = ИмяДокументаКорректировкиРегистров();
	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
		ДобавитьСообщение(Результат,
			"В конфигурации не найден документ «Корректировка регистров».
			|Без него нельзя независимо обнулить Запасы и ЗапасыНаСкладах (из-за расхождения возникает цикл ±N).",
			Истина);
		Возврат;
	КонецЕсли;
	
	// Включая резервы (ЗаказПокупателя) — иначе в отчёте остаются минусы «Резерв»
	ТаблицаЗапасы = ВсеОстаткиЗапасы(
		ПараметрыОбнуления.Организация,
		ПараметрыОбнуления.Склад,
		ПараметрыОбнуления.Дата);
	
	ТаблицаСклад = ВсеОстаткиЗапасыНаСкладах(
		ПараметрыОбнуления.Организация,
		ПараметрыОбнуления.Склад,
		ПараметрыОбнуления.Дата);
	
	Если ТаблицаЗапасы.Количество() = 0 И ТаблицаСклад.Количество() = 0 Тогда
		ДобавитьСообщение(Результат, "Ненулевых остатков для корректировки не найдено.");
		Возврат;
	КонецЕсли;
	
	КоличествоСРезервом = 0;
	Для Каждого СтрокаЗапасы Из ТаблицаЗапасы Цикл
		Если ЗначениеЗаполнено(СтрокаЗапасы.ЗаказПокупателя) Тогда
			КоличествоСРезервом = КоличествоСРезервом + 1;
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьСообщение(Результат,
		СтрШаблон(
			"Корректировка регистров: Запасы=%1 (с резервом/заказом=%2), ЗапасыНаСкладах=%3...",
			ТаблицаЗапасы.Количество(),
			КоличествоСРезервом,
			ТаблицаСклад.Количество()));
	
	Попытка
		
		ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
		ДокументОбъект.Дата = ПараметрыОбнуления.Дата;
		ДокументОбъект.Комментарий = СтрШаблон(
			"Автообнуление склада «%1», организация «%2»",
			ПараметрыОбнуления.Склад,
			ПараметрыОбнуления.Организация);
		
		Если ДокументОбъект.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
			ДокументОбъект.Организация = ПараметрыОбнуления.Организация;
		КонецЕсли;
		
		ДобавитьРегистрВДокументКорректировки(ДокументОбъект, "Запасы");
		ДобавитьРегистрВДокументКорректировки(ДокументОбъект, "ЗапасыНаСкладах");
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		
		ЗаполнитьДвиженияОбнуленияЗапасы(ДокументОбъект, ТаблицаЗапасы, ПараметрыОбнуления.Дата);
		ЗаполнитьДвиженияОбнуленияЗапасыНаСкладах(
			ДокументОбъект,
			ТаблицаСклад,
			ПараметрыОбнуления.Дата,
			ПараметрыОбнуления.Организация);
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		
		Если ПараметрыОбнуления.ПроводитьДокументы Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
		ДобавитьСообщение(Результат,
			СтрШаблон("Корректировка регистров: %1, проведён: %2",
				ДокументОбъект.Ссылка,
				Формат(ДокументОбъект.Ссылка.Проведен, "БЛ=Нет; БИ=Да")));
		
		Если Не Результат.Свойство("ДокументыКорректировки") Тогда
			Результат.Вставить("ДокументыКорректировки", Новый Массив);
		КонецЕсли;
		Результат.ДокументыКорректировки.Добавить(ДокументОбъект.Ссылка);
		
		// Список номенклатуры берёт «Свободно»/«В резерве» из РС ОстаткиТоваров
		ОбновитьКэшОстатковТоваров(ПараметрыОбнуления, Результат);
		
	Исключение
		ДобавитьСообщение(Результат,
			СтрШаблон("Ошибка корректировки регистров: %1",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			Истина);
	КонецПопытки;
	
КонецПроцедуры

// Обновляет регистр сведений «Остатки товаров» — от него зависят колонки
// «Свободно» и «В резерве» в справочнике Номенклатура.
//
Процедура ОбновитьКэшОстатковТоваров(ПараметрыОбнуления, Результат)
	
	Если Метаданные.РегистрыСведений.Найти("ОстаткиТоваров") = Неопределено Тогда
		ДобавитьСообщение(Результат,
			"Регистр сведений ОстаткиТоваров не найден. Обновите остатки вручную: Номенклатура → Ещё → Обновить остатки.");
		Возврат;
	КонецЕсли;
	
	// 1. Типовые методы конфигурации (как кнопка «Обновить остатки»)
	Если ВызватьТиповоеОбновлениеОстатковТоваров() Тогда
		ДобавитьСообщение(Результат,
			"Кэш остатков (ОстаткиТоваров) обновлён типовым методом конфигурации.");
		Возврат;
	КонецЕсли;
	
	// 2. Пересчёт по фактическим остаткам регистров накопления
	Попытка
		ПересчитатьОстаткиТоваровПоСкладу(
			ПараметрыОбнуления.Организация,
			ПараметрыОбнуления.Склад,
			ПараметрыОбнуления.Дата);
		ДобавитьСообщение(Результат,
			"Кэш остатков (ОстаткиТоваров) пересчитан по фактическим регистрам.");
	Исключение
		ДобавитьСообщение(Результат,
			СтрШаблон(
				"Не удалось обновить кэш ОстаткиТоваров автоматически: %1
				|Сделайте вручную: Номенклатура → Ещё → Обновить остатки.",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			Истина);
	КонецПопытки;
	
КонецПроцедуры

Функция ВызватьТиповоеОбновлениеОстатковТоваров()
	
	// Перебор типичных API УНФ / Розницы 3
	Варианты = Новый Массив;
	Варианты.Добавить(Новый Структура("Модуль, Метод", "НоменклатураВДокументахСервер", "ОбновитьОстаткиТоваров"));
	Варианты.Добавить(Новый Структура("Модуль, Метод", "НоменклатураВДокументах", "ОбновитьОстаткиТоваров"));
	Варианты.Добавить(Новый Структура("Модуль, Метод", "УправлениеНебольшойФирмойСервер", "ОбновитьОстаткиТоваров"));
	Варианты.Добавить(Новый Структура("Модуль, Метод", "РаботаСТоварами", "ОбновитьОстаткиТоваров"));
	Варианты.Добавить(Новый Структура("Модуль, Метод", "ОстаткиТоваров", "ОбновитьОстатки"));
	
	Для Каждого Вариант Из Варианты Цикл
		Если Метаданные.ОбщиеМодули.Найти(Вариант.Модуль) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ОбщегоНазначения.ВыполнитьМетодКонфигурации(
				Вариант.Модуль + "." + Вариант.Метод,
				Новый Массив);
			Возврат Истина;
		Исключение
		КонецПопытки;
		Попытка
			Выполнить(Вариант.Модуль + "." + Вариант.Метод + "()");
			Возврат Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	// Менеджер регистра сведений
	Попытка
		Менеджер = РегистрыСведений.ОстаткиТоваров;
		Попытка
			Менеджер.ОбновитьОстатки();
			Возврат Истина;
		Исключение
		КонецПопытки;
		Попытка
			Менеджер.ВыполнитьОбновлениеОстатков();
			Возврат Истина;
		Исключение
		КонецПопытки;
	Исключение
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

Процедура ПересчитатьОстаткиТоваровПоСкладу(Организация, Склад, Дата)
	
	МетаРС = Метаданные.РегистрыСведений.ОстаткиТоваров;
	
	// Фактические свободные и резерв из Запасы
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	Остатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(ВЫБОР
	|			КОГДА Остатки.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|				ТОГДА Остатки.КоличествоОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Свободно,
	|	СУММА(ВЫБОР
	|			КОГДА Остатки.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|				ТОГДА Остатки.КоличествоОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВРезерве,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			&Граница,
	|			Организация = &Организация
	|				И СтруктурнаяЕдиница = &Склад) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Организация,
	|	Остатки.СтруктурнаяЕдиница,
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика";
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	ТаблицаФакт = Запрос.Выполнить().Выгрузить();
	
	// Удаляем старые записи кэша по складу/организации
	НаборУдаления = РегистрыСведений.ОстаткиТоваров.СоздатьНаборЗаписей();
	
	Если МетаРС.Измерения.Найти("СтруктурнаяЕдиница") <> Неопределено Тогда
		НаборУдаления.Отбор.СтруктурнаяЕдиница.Установить(Склад);
	ИначеЕсли МетаРС.Измерения.Найти("Склад") <> Неопределено Тогда
		НаборУдаления.Отбор.Склад.Установить(Склад);
	КонецЕсли;
	
	Если МетаРС.Измерения.Найти("Организация") <> Неопределено Тогда
		НаборУдаления.Отбор.Организация.Установить(Организация);
	КонецЕсли;
	
	НаборУдаления.Прочитать();
	НаборУдаления.Очистить();
	НаборУдаления.Записать();
	
	// Пишем актуальные (только ненулевые)
	Для Каждого СтрокаФакт Из ТаблицаФакт Цикл
		
		Если СтрокаФакт.Количество = 0 И СтрокаФакт.Свободно = 0 И СтрокаФакт.ВРезерве = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ОстаткиТоваров.СоздатьМенеджерЗаписи();
		
		УстановитьИзмерениеРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Организация", СтрокаФакт.Организация);
		УстановитьИзмерениеРСЕслиЕсть(МенеджерЗаписи, МетаРС, "СтруктурнаяЕдиница", СтрокаФакт.СтруктурнаяЕдиница);
		УстановитьИзмерениеРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Склад", СтрокаФакт.СтруктурнаяЕдиница);
		УстановитьИзмерениеРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Номенклатура", СтрокаФакт.Номенклатура);
		УстановитьИзмерениеРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Характеристика", СтрокаФакт.Характеристика);
		
		УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Количество", СтрокаФакт.Количество);
		УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, "КоличествоНаСкладе", СтрокаФакт.Количество);
		УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Свободно", СтрокаФакт.Свободно);
		УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, "СвободныйОстаток", СтрокаФакт.Свободно);
		УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, "ВРезерве", СтрокаФакт.ВРезерве);
		УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, "Резерв", СтрокаФакт.ВРезерве);
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьИзмерениеРСЕслиЕсть(МенеджерЗаписи, МетаРС, ИмяПоля, Значение)
	
	Если МетаРС.Измерения.Найти(ИмяПоля) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи[ИмяПоля] = Значение;
	
КонецПроцедуры

Процедура УстановитьРесурсРСЕслиЕсть(МенеджерЗаписи, МетаРС, ИмяПоля, Значение)
	
	Если МетаРС.Ресурсы.Найти(ИмяПоля) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи[ИмяПоля] = Значение;
	
КонецПроцедуры

Функция ИмяДокументаКорректировкиРегистров()
	
	Если Метаданные.Документы.Найти("КорректировкаРегистров") <> Неопределено Тогда
		Возврат "КорректировкаРегистров";
	КонецЕсли;
	Если Метаданные.Документы.Найти("КорректировкаЗаписейРегистров") <> Неопределено Тогда
		Возврат "КорректировкаЗаписейРегистров";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ДобавитьРегистрВДокументКорректировки(ДокументОбъект, ИмяРегистра)
	
	МетаДокумента = ДокументОбъект.Метаданные();
	
	Если МетаДокумента.ТабличныеЧасти.Найти("ТаблицаРегистров") <> Неопределено Тогда
		Отбор = Новый Структура("Имя", ИмяРегистра);
		Если ДокументОбъект.ТаблицаРегистров.НайтиСтроки(Отбор).Количество() = 0 Тогда
			СтрокаТЧ = ДокументОбъект.ТаблицаРегистров.Добавить();
			СтрокаТЧ.Имя = ИмяРегистра;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если МетаДокумента.ТабличныеЧасти.Найти("ТаблицаРегистровНакопления") <> Неопределено Тогда
		Отбор = Новый Структура("Имя", ИмяРегистра);
		Если ДокументОбъект.ТаблицаРегистровНакопления.НайтиСтроки(Отбор).Количество() = 0 Тогда
			СтрокаТЧ = ДокументОбъект.ТаблицаРегистровНакопления.Добавить();
			СтрокаТЧ.Имя = ИмяРегистра;
			Если МетаДокумента.ТабличныеЧасти.ТаблицаРегистровНакопления.Реквизиты.Найти("Представление") <> Неопределено Тогда
				СтрокаТЧ.Представление = ИмяРегистра;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ВсеОстаткиЗапасы(Организация, Склад, Дата)
	
	// Включая строки с ЗаказПокупателя (резерв) — иначе минусы «В резерве» остаются.
	ЕстьЗаказНаПроизводство = Метаданные.РегистрыНакопления.Запасы.Измерения.Найти("ЗаказНаПроизводство") <> Неопределено;
	ТекстЗаказНаПроизводствоПоле = ?(ЕстьЗаказНаПроизводство,
		"Остатки.ЗаказНаПроизводство КАК ЗаказНаПроизводство,",
		"НЕОПРЕДЕЛЕНО КАК ЗаказНаПроизводство,");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	Остатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Партия КАК Партия,
	|	Остатки.СчетУчета КАК СчетУчета,
	|	Остатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	" + ТекстЗаказНаПроизводствоПоле + "
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			&Граница,
	|			Организация = &Организация
	|				И СтруктурнаяЕдиница = &Склад) КАК Остатки
	|ГДЕ
	|	(Остатки.КоличествоОстаток <> 0
	|		ИЛИ Остатки.СуммаОстаток <> 0)";
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВсеОстаткиЗапасыБезРезерва(Организация, Склад, Дата)
	
	Возврат ВсеОстаткиЗапасы(Организация, Склад, Дата);
	
КонецФункции

Функция ВсеОстаткиЗапасыНаСкладах(Организация, Склад, Дата)
	
	МетаРегистра = Метаданные.РегистрыНакопления.ЗапасыНаСкладах;
	ЕстьЯчейка = МетаРегистра.Измерения.Найти("Ячейка") <> Неопределено;
	ЕстьОрганизация = МетаРегистра.Измерения.Найти("Организация") <> Неопределено;
	
	ТекстЯчейка = ?(ЕстьЯчейка, "Остатки.Ячейка КАК Ячейка,", "НЕОПРЕДЕЛЕНО КАК Ячейка,");
	ТекстОрганизацияПоле = ?(ЕстьОрганизация,
		"Остатки.Организация КАК Организация,",
		"&Организация КАК Организация,");
	
	УсловиеОстатков = "СтруктурнаяЕдиница = &Склад";
	Если ЕстьОрганизация Тогда
		УсловиеОстатков = УсловиеОстатков + " И Организация = &Организация";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + ТекстОрганизацияПоле + "
	|	Остатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Партия КАК Партия,
	|	" + ТекстЯчейка + "
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(&Граница, " + УсловиеОстатков + ") КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток <> 0";
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьДвиженияОбнуленияЗапасы(ДокументОбъект, ТаблицаОстатков, Дата)
	
	Набор = ДокументОбъект.Движения.Запасы;
	Набор.Записывать = Истина;
	Набор.Очистить();
	
	ЕстьЗаказНаПроизводство = Метаданные.РегистрыНакопления.Запасы.Измерения.Найти("ЗаказНаПроизводство") <> Неопределено;
	
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		
		Если СтрокаОстатка.Количество = 0 И СтрокаОстатка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаОстатка.Количество > 0 Или (СтрокаОстатка.Количество = 0 И СтрокаОстатка.Сумма > 0) Тогда
			Движение = Набор.ДобавитьРасход();
			Движение.Количество = ?(СтрокаОстатка.Количество > 0, СтрокаОстатка.Количество, 0);
			Движение.Сумма = ?(СтрокаОстатка.Сумма > 0, СтрокаОстатка.Сумма, 0);
		Иначе
			Движение = Набор.ДобавитьПриход();
			Движение.Количество = ?(СтрокаОстатка.Количество < 0, -СтрокаОстатка.Количество, 0);
			Движение.Сумма = ?(СтрокаОстатка.Сумма < 0, -СтрокаОстатка.Сумма, 0);
		КонецЕсли;
		
		Движение.Период = Дата;
		Движение.Организация = СтрокаОстатка.Организация;
		Движение.СтруктурнаяЕдиница = СтрокаОстатка.СтруктурнаяЕдиница;
		Движение.Номенклатура = СтрокаОстатка.Номенклатура;
		Движение.Характеристика = СтрокаОстатка.Характеристика;
		Движение.Партия = СтрокаОстатка.Партия;
		Движение.СчетУчета = СтрокаОстатка.СчетУчета;
		Движение.ЗаказПокупателя = СтрокаОстатка.ЗаказПокупателя;
		Движение.Активность = Истина;
		
		Если ЕстьЗаказНаПроизводство Тогда
			Попытка
				Если ЗначениеЗаполнено(СтрокаОстатка.ЗаказНаПроизводство) Тогда
					Движение.ЗаказНаПроизводство = СтрокаОстатка.ЗаказНаПроизводство;
				Иначе
					Движение.ЗаказНаПроизводство = Документы.ЗаказНаПроизводство.ПустаяСсылка();
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДвиженияОбнуленияЗапасыНаСкладах(ДокументОбъект, ТаблицаОстатков, Дата, Организация)
	
	Набор = ДокументОбъект.Движения.ЗапасыНаСкладах;
	Набор.Записывать = Истина;
	Набор.Очистить();
	
	МетаРегистра = Метаданные.РегистрыНакопления.ЗапасыНаСкладах;
	ЕстьЯчейка = МетаРегистра.Измерения.Найти("Ячейка") <> Неопределено;
	ЕстьОрганизация = МетаРегистра.Измерения.Найти("Организация") <> Неопределено;
	
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		
		Если СтрокаОстатка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаОстатка.Количество > 0 Тогда
			Движение = Набор.ДобавитьРасход();
			Движение.Количество = СтрокаОстатка.Количество;
		Иначе
			Движение = Набор.ДобавитьПриход();
			Движение.Количество = -СтрокаОстатка.Количество;
		КонецЕсли;
		
		Движение.Период = Дата;
		Движение.СтруктурнаяЕдиница = СтрокаОстатка.СтруктурнаяЕдиница;
		Движение.Номенклатура = СтрокаОстатка.Номенклатура;
		Движение.Характеристика = СтрокаОстатка.Характеристика;
		Движение.Партия = СтрокаОстатка.Партия;
		Движение.Активность = Истина;
		
		Если ЕстьОрганизация Тогда
			ОрганизацияСтроки = Неопределено;
			Попытка
				ОрганизацияСтроки = СтрокаОстатка.Организация;
			Исключение
			КонецПопытки;
			Движение.Организация = ?(ЗначениеЗаполнено(ОрганизацияСтроки), ОрганизацияСтроки, Организация);
		КонецЕсли;
		
		Если ЕстьЯчейка И ЗначениеЗаполнено(СтрокаОстатка.Ячейка) Тогда
			Движение.Ячейка = СтрокаОстатка.Ячейка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОприходованиеОтрицательныхОстатков

Процедура ЗакрытьОтрицательныеОстатки(ПараметрыОбнуления, Результат)
	
	ТаблицаОтрицательных = СобратьОтрицательныеОстаткиКЗакрытию(ПараметрыОбнуления);
	Результат.КоличествоОтрицательных = ТаблицаОтрицательных.Количество();
	
	Если ТаблицаОтрицательных.Количество() = 0 Тогда
		ДобавитьСообщение(Результат, "Отрицательные остатки по складу не найдены.");
		Возврат;
	КонецЕсли;
	
	Корреспонденция = КорреспонденцияДляОприходования(ПараметрыОбнуления.Корреспонденция);
	Если Не ЗначениеЗаполнено(Корреспонденция) Тогда
		ДобавитьСообщение(Результат,
			"Не удалось определить счет корреспонденции для оприходования (нужен тип «Прочие доходы»).
			|Укажите такой счет в поле Корреспонденция или создайте его в плане счетов.",
			Истина);
		Возврат;
	КонецЕсли;
	
	ДобавитьСообщение(Результат,
		СтрШаблон("Найдено отрицательных остатков: %1. Формируются документы оприходования...",
			ТаблицаОтрицательных.Количество()));
	
	Лимит = ПараметрыОбнуления.ЛимитСтрокВДокументе;
	Если Лимит <= 0 Тогда
		Лимит = 500;
	КонецЕсли;
	
	ПакетСтрок = Новый Массив;
	Счетчик = 0;
	
	Для Каждого СтрокаОстатка Из ТаблицаОтрицательных Цикл
		
		ПакетСтрок.Добавить(СтрокаОстатка);
		Счетчик = Счетчик + 1;
		
		Если Счетчик >= Лимит Тогда
			ЗаписатьПакетОприходования(ПараметрыОбнуления, ПакетСтрок, Корреспонденция, Результат);
			ПакетСтрок.Очистить();
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПакетСтрок.Количество() > 0 Тогда
		ЗаписатьПакетОприходования(ПараметрыОбнуления, ПакетСтрок, Корреспонденция, Результат);
	КонецЕсли;
	
КонецПроцедуры

Функция СобратьОтрицательныеОстаткиКЗакрытию(ПараметрыОбнуления)
	
	// Ключ: номенклатура|характеристика|партия → структура строки
	Карта = Новый Соответствие;
	
	ТаблицаЗапасы = ПолучитьОтрицательныеОстатки(
		ПараметрыОбнуления.Организация,
		ПараметрыОбнуления.Склад,
		ПараметрыОбнуления.Дата);
	
	Для Каждого СтрокаОстатка Из ТаблицаЗапасы Цикл
		Ключ = КлючНоменклатуры(СтрокаОстатка.Номенклатура, СтрокаОстатка.Характеристика, СтрокаОстатка.Партия);
		Данные = Новый Структура;
		Данные.Вставить("Номенклатура", СтрокаОстатка.Номенклатура);
		Данные.Вставить("Характеристика", СтрокаОстатка.Характеристика);
		Данные.Вставить("Партия", СтрокаОстатка.Партия);
		Данные.Вставить("СчетУчета", СтрокаОстатка.СчетУчета);
		Данные.Вставить("Ячейка", Неопределено);
		Данные.Вставить("Количество", -СтрокаОстатка.Количество); // к оприходованию — модуль минуса
		Данные.Вставить("Сумма", ?(СтрокаОстатка.Сумма < 0, -СтрокаОстатка.Сумма, 0));
		Карта.Вставить(Ключ, Данные);
	КонецЦикла;
	
	ТаблицаСклад = ПолучитьОтрицательныеОстаткиНаСкладах(
		ПараметрыОбнуления.Склад,
		ПараметрыОбнуления.Дата);
	
	Для Каждого СтрокаСклада Из ТаблицаСклад Цикл
		
		Ключ = КлючНоменклатуры(СтрокаСклада.Номенклатура, СтрокаСклада.Характеристика, СтрокаСклада.Партия);
		КоличествоКОприходованию = -СтрокаСклада.Количество;
		
		Данные = Карта.Получить(Ключ);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура;
			Данные.Вставить("Номенклатура", СтрокаСклада.Номенклатура);
			Данные.Вставить("Характеристика", СтрокаСклада.Характеристика);
			Данные.Вставить("Партия", СтрокаСклада.Партия);
			Данные.Вставить("СчетУчета", Неопределено);
			Данные.Вставить("Ячейка", СтрокаСклада.Ячейка);
			Данные.Вставить("Количество", КоличествоКОприходованию);
			Данные.Вставить("Сумма", 0);
			Карта.Вставить(Ключ, Данные);
		Иначе
			Если Данные.Количество < КоличествоКОприходованию Тогда
				Данные.Количество = КоличествоКОприходованию;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Данные.Ячейка) И ЗначениеЗаполнено(СтрокаСклада.Ячейка) Тогда
				Данные.Ячейка = СтрокаСклада.Ячейка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("Номенклатура");
	ТаблицаРезультат.Колонки.Добавить("Характеристика");
	ТаблицаРезультат.Колонки.Добавить("Партия");
	ТаблицаРезультат.Колонки.Добавить("СчетУчета");
	ТаблицаРезультат.Колонки.Добавить("Ячейка");
	ТаблицаРезультат.Колонки.Добавить("Количество");
	ТаблицаРезультат.Колонки.Добавить("Сумма");
	
	Для Каждого КлючИЗначение Из Карта Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючИЗначение.Значение);
	КонецЦикла;
	
	ТаблицаРезультат.Сортировать("Номенклатура");
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция КорреспонденцияДляОприходования(ТекущаяКорреспонденция)
	
	// Если уже указан счет прочих доходов — используем его
	Если ЗначениеЗаполнено(ТекущаяКорреспонденция) Тогда
		Попытка
			ТипСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяКорреспонденция, "ТипСчета");
			ИмяТипа = ВРег(Строка(ТипСчета));
			Если СтрНайти(ИмяТипа, "ДОХОД") > 0 Или СтрНайти(ИмяТипа, "КАПИТАЛ") > 0 Тогда
				Возврат ТекущаяКорреспонденция;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Ищем счет с типом «Прочие доходы»
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Управленческий.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.Управленческий КАК Управленческий
		|ГДЕ
		|	НЕ Управленческий.ПометкаУдаления
		|	И НЕ Управленческий.ЗапретитьИспользоватьВПроводках
		|	И (Управленческий.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.ПрочиеДоходы)
		|		ИЛИ Управленческий.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.ПрочиеДоходыРаспределяемыеНаФинансовыйРезультат))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Управленческий.Код";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	// Перебор по представлению типа счета
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Управленческий.Ссылка КАК Ссылка,
		|	Управленческий.ТипСчета КАК ТипСчета
		|ИЗ
		|	ПланСчетов.Управленческий КАК Управленческий
		|ГДЕ
		|	НЕ Управленческий.ПометкаУдаления";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИмяТипа = ВРег(Строка(Выборка.ТипСчета));
			Если СтрНайти(ИмяТипа, "ПРОЧИЕ ДОХОД") > 0 Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	// В крайнем случае — то, что указал пользователь (может провестись)
	Возврат ТекущаяКорреспонденция;
	
КонецФункции

Процедура ЗаписатьПакетОприходования(ПараметрыОбнуления, ПакетСтрок, Корреспонденция, Результат)
	
	Попытка
		ДокументСсылка = СоздатьДокументОприходования(ПараметрыОбнуления, ПакетСтрок, Корреспонденция);
		Результат.ДокументыОприходования.Добавить(ДокументСсылка);
		ДобавитьСообщение(Результат,
			СтрШаблон("Оприходование: %1 (%2 стр.), проведён: %3",
				ДокументСсылка,
				ПакетСтрок.Количество(),
				Формат(ДокументСсылка.Проведен, "БЛ=Нет; БИ=Да")));
	Исключение
		ДобавитьСообщение(Результат,
			СтрШаблон("Ошибка оприходования отрицательных остатков: %1",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
			Истина);
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьДокументОприходования(ПараметрыОбнуления, ПакетСтрок, Корреспонденция)
	
	ДокументОбъект = Документы.ОприходованиеЗапасов.СоздатьДокумент();
	ДокументОбъект.Дата = ПараметрыОбнуления.Дата;
	ДокументОбъект.Организация = ПараметрыОбнуления.Организация;
	ДокументОбъект.СтруктурнаяЕдиница = ПараметрыОбнуления.Склад;
	ДокументОбъект.Корреспонденция = Корреспонденция;
	ДокументОбъект.Комментарий = "Автоматическое закрытие отрицательных остатков";
	
	МетаданныеТЧ = ДокументОбъект.Метаданные().ТабличныеЧасти.Запасы;
	ЕстьЯчейка = МетаданныеТЧ.Реквизиты.Найти("Ячейка") <> Неопределено;
	ЕстьЕдиницаИзмерения = МетаданныеТЧ.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено;
	ЕстьСчетУчета = МетаданныеТЧ.Реквизиты.Найти("СчетУчета") <> Неопределено;
	ЕстьЦена = МетаданныеТЧ.Реквизиты.Найти("Цена") <> Неопределено;
	ЕстьСумма = МетаданныеТЧ.Реквизиты.Найти("Сумма") <> Неопределено;
	НуженПропускПроверкиХарактеристики = Ложь;
	
	// Важно: строки строго как в минусовом остатке (без «подбора» характеристик),
	// иначе оприходование уходит в другой разрез и минус остаётся.
	Для Каждого СтрокаОстатка Из ПакетСтрок Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаОстатка.Характеристика)
			И НоменклатураТребуетХарактеристику(СтрокаОстатка.Номенклатура) Тогда
			НуженПропускПроверкиХарактеристики = Истина;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Запасы.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОстатка.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаОстатка.Характеристика;
		НоваяСтрока.Партия = СтрокаОстатка.Партия;
		НоваяСтрока.Количество = СтрокаОстатка.Количество;
		
		Если ЕстьЕдиницаИзмерения Тогда
			НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				СтрокаОстатка.Номенклатура, "ЕдиницаИзмерения");
		КонецЕсли;
		
		Если ЕстьСчетУчета Тогда
			СчетУчета = СтрокаОстатка.СчетУчета;
			Если Не ЗначениеЗаполнено(СчетУчета) Тогда
				СчетУчета = СчетУчетаНоменклатуры(СтрокаОстатка.Номенклатура);
			КонецЕсли;
			Если ЗначениеЗаполнено(СчетУчета) Тогда
				НоваяСтрока.СчетУчета = СчетУчета;
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьЯчейка И ЗначениеЗаполнено(СтрокаОстатка.Ячейка) Тогда
			НоваяСтрока.Ячейка = СтрокаОстатка.Ячейка;
		КонецЕсли;
		
		КоличествоСтроки = СтрокаОстатка.Количество;
		СуммаСтроки = 0;
		Если СтрокаОстатка.Сумма > 0 Тогда
			СуммаСтроки = СтрокаОстатка.Сумма;
		КонецЕсли;
		
		ЦенаСтроки = 0;
		Если КоличествоСтроки <> 0 И СуммаСтроки > 0 Тогда
			ЦенаСтроки = Окр(СуммаСтроки / КоличествоСтроки, 2);
		КонецЕсли;
		
		Если ЦенаСтроки <= 0 Тогда
			ЦенаСтроки = 0.01;
		КонецЕсли;
		Если СуммаСтроки <= 0 Тогда
			СуммаСтроки = Окр(ЦенаСтроки * КоличествоСтроки, 2);
			Если СуммаСтроки <= 0 Тогда
				СуммаСтроки = 0.01;
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьЦена Тогда
			НоваяСтрока.Цена = ЦенаСтроки;
		КонецЕсли;
		Если ЕстьСумма Тогда
			НоваяСтрока.Сумма = СуммаСтроки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НуженПропускПроверкиХарактеристики Тогда
		ОтключенныеПроверки = ОтключитьПроверкуХарактеристикВНоменклатуре(ДокументОбъект);
	Иначе
		ОтключенныеПроверки = Новый Массив;
	КонецЕсли;
	
	Попытка
		Статус = ЗаписатьИПровестиДокумент(ДокументОбъект, ПараметрыОбнуления.ПроводитьДокументы);
	Исключение
		ВосстановитьПроверкуХарактеристикВНоменклатуре(ОтключенныеПроверки);
		ВызватьИсключение;
	КонецПопытки;
	
	ВосстановитьПроверкуХарактеристикВНоменклатуре(ОтключенныеПроверки);
	
	Если ПараметрыОбнуления.ПроводитьДокументы И Не Статус.Проведен Тогда
		ВызватьИсключение СтрШаблон(
			"Документ оприходования записан, но не проведён: %1",
			Статус.Ссылка);
	КонецЕсли;
	
	Возврат Статус.Ссылка;
	
КонецФункции

Функция СчетУчетаНоменклатуры(Номенклатура)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("СчетУчетаЗапасов");
	ИменаРеквизитов.Добавить("СчетУчетаТоваров");
	ИменаРеквизитов.Добавить("СчетУчета");
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если Номенклатура.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗначениеСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, ИмяРеквизита);
			Если ЗначениеЗаполнено(ЗначениеСчета) Тогда
				Возврат ЗначениеСчета;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗаписатьИПровестиДокумент(ДокументОбъект, Проводить)
	
	Результат = Новый Структура("Ссылка, Проведен", Неопределено, Ложь);
	
	ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Запись);
	Результат.Ссылка = ДокументОбъект.Ссылка;
	
	Если Не Проводить Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДокументОбъект = ДокументОбъект.Ссылка.ПолучитьОбъект();
	ДокументОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьКонтрольОстатков", Истина);
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольОстатков", Истина);
	ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Проведение);
	
	Результат.Проведен = ДокументОбъект.Ссылка.Проведен;
	Если Не Результат.Проведен Тогда
		// повторная попытка
		ДокументОбъект = ДокументОбъект.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьКонтрольОстатков", Истина);
		ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписиДокумента.Проведение);
		Результат.Проведен = ДокументОбъект.Ссылка.Проведен;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Характеристики

// Возвращает массив структур: Номенклатура, Характеристика, Партия, Количество, ПропускПроверкиХарактеристики
//
Функция РазвернутьСтрокуПоХарактеристикам(Номенклатура, Характеристика, Партия, Количество,
	Организация, Склад, ЗаказПокупателя, Дата, ЭтоРезерв)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Характеристика)
		Или Не НоменклатураТребуетХарактеристику(Номенклатура) Тогда
		
		Результат.Добавить(НоваяСтрокаЗапаса(Номенклатура, Характеристика, Партия, Количество, Ложь));
		Возврат Результат;
		
	КонецЕсли;
	
	// 1. Детальные остатки с характеристиками в регистре Запасы
	ДетальныеОстатки = ОстаткиНоменклатурыСХарактеристиками(
		Номенклатура, Организация, Склад, ЗаказПокупателя, Дата, ЭтоРезерв);
	
	Если ДетальныеОстатки.Количество() > 0 Тогда
		Для Каждого СтрокаДетали Из ДетальныеОстатки Цикл
			Результат.Добавить(НоваяСтрокаЗапаса(
				Номенклатура,
				СтрокаДетали.Характеристика,
				?(ЗначениеЗаполнено(СтрокаДетали.Партия), СтрокаДетали.Партия, Партия),
				СтрокаДетали.Количество,
				Ложь));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
	// 2. Складской регистр ЗапасыНаСкладах (часто характеристика есть там)
	Если Не ЭтоРезерв Тогда
		СкладскиеОстатки = ОстаткиНаСкладахСХарактеристиками(Номенклатура, Склад, Дата);
		Если СкладскиеОстатки.Количество() > 0 Тогда
			Для Каждого СтрокаДетали Из СкладскиеОстатки Цикл
				Результат.Добавить(НоваяСтрокаЗапаса(
					Номенклатура,
					СтрокаДетали.Характеристика,
					?(ЗначениеЗаполнено(СтрокаДетали.Партия), СтрокаДетали.Партия, Партия),
					СтрокаДетали.Количество,
					Ложь));
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	// 3. Остаток реально без характеристики. Подставлять «3 шт»/«5 шт» нельзя —
	// иначе списание уйдёт в другой разрез, а «пустой» остаток останется.
	// Пишем как в регистре и отключаем проверку заполнения характеристики.
	Результат.Добавить(НоваяСтрокаЗапаса(Номенклатура, Характеристика, Партия, Количество, Истина));
	Возврат Результат;
	
КонецФункции

Функция НоваяСтрокаЗапаса(Номенклатура, Характеристика, Партия, Количество, ПропускПроверкиХарактеристики)
	
	СтрокаРезультата = Новый Структура(
		"Номенклатура, Характеристика, Партия, Количество, ПропускПроверкиХарактеристики");
	СтрокаРезультата.Номенклатура = Номенклатура;
	СтрокаРезультата.Характеристика = Характеристика;
	СтрокаРезультата.Партия = Партия;
	СтрокаРезультата.Количество = Количество;
	СтрокаРезультата.ПропускПроверкиХарактеристики = ПропускПроверкиХарактеристики;
	
	Возврат СтрокаРезультата;
	
КонецФункции

Функция ОстаткиНаСкладахСХарактеристиками(Номенклатура, Склад, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Партия КАК Партия,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|			&Граница,
	|			СтруктурнаяЕдиница = &Склад
	|				И Номенклатура = &Номенклатура
	|				И Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0";
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОстаткиНоменклатурыСХарактеристиками(Номенклатура, Организация, Склад, ЗаказПокупателя, Дата, ЭтоРезерв)
	
	Запрос = Новый Запрос;
	
	Если ЭтоРезерв Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗапасыОстатки.Характеристика КАК Характеристика,
		|	ЗапасыОстатки.Партия КАК Партия,
		|	ЗапасыОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(
		|			&Граница,
		|			Организация = &Организация
		|				И СтруктурнаяЕдиница = &Склад
		|				И Номенклатура = &Номенклатура
		|				И ЗаказПокупателя = &ЗаказПокупателя
		|				И Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ЗапасыОстатки
		|ГДЕ
		|	ЗапасыОстатки.КоличествоОстаток > 0";
		Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗапасыОстатки.Характеристика КАК Характеристика,
		|	ЗапасыОстатки.Партия КАК Партия,
		|	ЗапасыОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(
		|			&Граница,
		|			Организация = &Организация
		|				И СтруктурнаяЕдиница = &Склад
		|				И Номенклатура = &Номенклатура
		|				И ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|				И Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ЗапасыОстатки
		|ГДЕ
		|	ЗапасыОстатки.КоличествоОстаток > 0";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Если в остатке характеристика пустая, а для номенклатуры она обязательна —
// подставляем основную или единственную характеристику.
//
Функция ПодобратьХарактеристику(Номенклатура, ХарактеристикаИзОстатка)
	
	Если ЗначениеЗаполнено(ХарактеристикаИзОстатка) Тогда
		Возврат ХарактеристикаИзОстатка;
	КонецЕсли;
	
	Если Не НоменклатураТребуетХарактеристику(Номенклатура) Тогда
		Возврат ХарактеристикаИзОстатка;
	КонецЕсли;
	
	// 1. Основная характеристика в карточке номенклатуры
	ИменаРеквизитов = "ОсновнаяХарактеристика, ИспользоватьХарактеристики";
	Попытка
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ИменаРеквизитов);
		Если РеквизитыНоменклатуры.Свойство("ОсновнаяХарактеристика")
			И ЗначениеЗаполнено(РеквизитыНоменклатуры.ОсновнаяХарактеристика) Тогда
			Возврат РеквизитыНоменклатуры.ОсновнаяХарактеристика;
		КонецЕсли;
	Исключение
		Попытка
			ОсновнаяХарактеристика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ОсновнаяХарактеристика");
			Если ЗначениеЗаполнено(ОсновнаяХарактеристика) Тогда
				Возврат ОсновнаяХарактеристика;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	// 2. Первая характеристика владельца (номенклатура или категория)
	Характеристика = ПерваяХарактеристикаНоменклатуры(Номенклатура);
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Возврат Характеристика;
	КонецЕсли;
	
	Возврат ХарактеристикаИзОстатка;
	
КонецФункции

Функция НоменклатураТребуетХарактеристику(Номенклатура)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаФлагов = Новый Массив;
	ИменаФлагов.Добавить("ИспользоватьХарактеристики");
	ИменаФлагов.Добавить("ПроверятьЗаполнениеХарактеристики");
	ИменаФлагов.Добавить("ОбязательноеЗаполнениеХарактеристики");
	
	Для Каждого ИмяФлага Из ИменаФлагов Цикл
		Если Номенклатура.Метаданные().Реквизиты.Найти(ИмяФлага) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗначениеФлага = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, ИмяФлага);
			Если ЗначениеФлага = Истина Тогда
				Возврат Истина;
			КонецЕсли;
			// УНФ иногда хранит как перечисление Да/Нет
			Если Строка(ЗначениеФлага) = "Да" Тогда
				Возврат Истина;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПерваяХарактеристикаНоменклатуры(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
	|	И (ХарактеристикиНоменклатуры.Владелец = &Номенклатура
	|		ИЛИ ХарактеристикиНоменклатуры.Владелец = &КатегорияНоменклатуры)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикиНоменклатуры.Наименование";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	КатегорияНоменклатуры = Неопределено;
	Попытка
		КатегорияНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КатегорияНоменклатуры");
	Исключение
		Попытка
			КатегорияНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Категория");
		Исключение
		КонецПопытки;
	КонецПопытки;
	Запрос.УстановитьПараметр("КатегорияНоменклатуры", КатегорияНоменклатуры);
	
	ТаблицаХарактеристик = Запрос.Выполнить().Выгрузить();
	Если ТаблицаХарактеристик.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаХарактеристик[0].Ссылка;
	
КонецФункции

#КонецОбласти

#Область РаботаСБлокировками

Процедура ЗаписатьДокументСПовторами(ДокументОбъект, РежимЗаписи, ЧислоПопыток = 8)
	
	Для НомерПопытки = 1 По ЧислоПопыток Цикл
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписи);
			Возврат;
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если Не ЭтоКонфликтБлокировок(ТекстОшибки) Или НомерПопытки = ЧислоПопыток Тогда
				ВызватьИсключение;
			КонецЕсли;
			
			// Экспоненциальная пауза: 0.5с, 1с, 1.5с...
			ПаузаМс(500 * НомерПопытки);
			
			Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
				ДокументОбъект = ДокументОбъект.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоКонфликтБлокировок(ТекстОшибки)
	
	Текст = ВРег(Строка(ТекстОшибки));
	Возврат СтрНайти(Текст, "КОНФЛИКТ БЛОКИРОВОК") > 0
		Или СтрНайти(Текст, "LOCK CONFLICT") > 0
		Или СтрНайти(Текст, "DEADLOCK") > 0;
	
КонецФункции

Процедура ПаузаМс(Миллисекунд)
	
	Если Миллисекунд <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	КонецОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунд;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < КонецОжидания Цикл
		// ожидание снятия блокировок другими сеансами
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
