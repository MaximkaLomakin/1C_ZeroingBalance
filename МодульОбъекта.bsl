// Возвращает количественные остатки по регистру ЗапасыНаСкладах (складской учет).
//
Функция ПолучитьОстаткиНаСкладах(Склад, Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ЕстьЯчейка = Метаданные.РегистрыНакопления.ЗапасыНаСкладах.Измерения.Найти("Ячейка") <> Неопределено;
	
	Если ЕстьЯчейка Тогда
		ТекстЯчейкаПоле = "Остатки.Ячейка КАК Ячейка,";
	Иначе
		ТекстЯчейкаПоле = "НЕОПРЕДЕЛЕНО КАК Ячейка,";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.СтруктурнаяЕдиница КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Партия КАК Партия,
	|	" + ТекстЯчейкаПоле + "
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ЗапасыНаСкладах.Остатки(&Граница, СтруктурнаяЕдиница = &Склад) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

