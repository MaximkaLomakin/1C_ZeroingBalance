////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки «Обнуление остатков и резервов»
//
// Реквизиты создаются у ОБЪЕКТА обработки (не у формы!):
//  Организация, Склад, ДатаОбнуления, Корреспонденция,
//  СниматьРезервы, СписыватьОстатки, ПроводитьДокументы, ЛимитСтрокВДокументе
//
// Табличные части объекта:
//  Резервы  — Номенклатура, Характеристика, Партия, ЗаказПокупателя, Количество
//  Остатки  — Номенклатура, Характеристика, Партия, Количество, Сумма
//            (положительные и отрицательные; минус = к оприходованию)
//
// На форме разместить поля/таблицы, привязанные к Объект.*
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаОбнуления) Тогда
		Объект.ДатаОбнуления = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не Объект.СниматьРезервы И Не Объект.СписыватьОстатки Тогда
		Объект.СниматьРезервы = Истина;
		Объект.СписыватьОстатки = Истина;
	КонецЕсли;
	
	Если Объект.ЛимитСтрокВДокументе = 0 Тогда
		Объект.ЛимитСтрокВДокументе = 500;
	КонецЕсли;
	
	Объект.ПроводитьДокументы = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ПроверитьЗаполнениеОтбора() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбнуление(Команда)
	
	Если Не ПроверитьЗаполнениеОтбора() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.СписыватьОстатки И Не ЗначениеЗаполнено(Объект.Корреспонденция) Тогда
		ПоказатьПредупреждение(,
			"Укажите счет корреспонденции.
			|Для списания плюсов — «Прочие расходы»,
			|для закрытия минусов обработка сама подберёт «Прочие доходы» (если есть в плане счетов).");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(
		"Будет выполнено обнуление по организации «%1» на складе «%2».
		|Снятие резервов: %3
		|Обнуление остатков (корректировка регистров Запасы + ЗапасыНаСкладах): %4
		|Проводить документы: %5
		|
		|Продолжить?",
		Объект.Организация,
		Объект.Склад,
		Формат(Объект.СниматьРезервы, "БЛ=Нет; БИ=Да"),
		Формат(Объект.СписыватьОстатки, "БЛ=Нет; БИ=Да"),
		Формат(Объект.ПроводитьДокументы, "БЛ=Нет; БИ=Да"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОбнулениеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбнулениеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ВыполнитьОбнулениеНаСервере();
	
	Если Результат.Выполнено Тогда
		ПоказатьПредупреждение(, "Обнуление выполнено успешно. См. сообщения.");
	Иначе
		ПоказатьПредупреждение(, "Обнуление завершено с ошибками. См. сообщения.");
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПроверитьЗаполнениеОтбора()
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ПоказатьПредупреждение(, "Укажите организацию.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
		ПоказатьПредупреждение(, "Укажите склад.");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ТаблицаРезервов = ОбработкаОбъект.ПолучитьРезервы(
		ОбработкаОбъект.Организация,
		ОбработкаОбъект.Склад,
		ОбработкаОбъект.ДатаОбнуления);
	ОбработкаОбъект.Резервы.Загрузить(ТаблицаРезервов);
	
	// Плюсы и минусы в одной таблице «Остатки»
	ТаблицаОстатков = ОбработкаОбъект.ПолучитьСвободныеОстатки(
		ОбработкаОбъект.Организация,
		ОбработкаОбъект.Склад,
		ОбработкаОбъект.ДатаОбнуления);
	
	ТаблицаМинусов = ОбработкаОбъект.ПолучитьОтрицательныеОстатки(
		ОбработкаОбъект.Организация,
		ОбработкаОбъект.Склад,
		ОбработкаОбъект.ДатаОбнуления);
	
	Для Каждого СтрокаМинуса Из ТаблицаМинусов Цикл
		НоваяСтрока = ТаблицаОстатков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМинуса);
	КонецЦикла;
	
	// Минусы только в складском регистре (без организации в Запасы)
	ТаблицаСкладскихМинусов = ОбработкаОбъект.ПолучитьОтрицательныеОстаткиНаСкладах(
		ОбработкаОбъект.Склад,
		ОбработкаОбъект.ДатаОбнуления);
	
	Для Каждого СтрокаСклада Из ТаблицаСкладскихМинусов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", СтрокаСклада.Номенклатура);
		Отбор.Вставить("Характеристика", СтрокаСклада.Характеристика);
		Отбор.Вставить("Партия", СтрокаСклада.Партия);
		
		Если ТаблицаОстатков.НайтиСтроки(Отбор).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОстатков.Добавить();
		НоваяСтрока.Номенклатура = СтрокаСклада.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаСклада.Характеристика;
		НоваяСтрока.Партия = СтрокаСклада.Партия;
		НоваяСтрока.Количество = СтрокаСклада.Количество;
		НоваяСтрока.Сумма = 0;
		
	КонецЦикла;
	
	ТаблицаОстатков.Сортировать("Номенклатура");
	ОбработкаОбъект.Остатки.Загрузить(ТаблицаОстатков);
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон("Резервов: %1, строк остатков (включая минусы): %2",
			ТаблицаРезервов.Количество(),
			ТаблицаОстатков.Количество()));
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьОбнулениеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыОбнуления = Новый Структура;
	ПараметрыОбнуления.Вставить("Организация", ОбработкаОбъект.Организация);
	ПараметрыОбнуления.Вставить("Склад", ОбработкаОбъект.Склад);
	ПараметрыОбнуления.Вставить("Дата", ОбработкаОбъект.ДатаОбнуления);
	ПараметрыОбнуления.Вставить("Корреспонденция", ОбработкаОбъект.Корреспонденция);
	ПараметрыОбнуления.Вставить("СниматьРезервы", ОбработкаОбъект.СниматьРезервы);
	ПараметрыОбнуления.Вставить("СписыватьОстатки", ОбработкаОбъект.СписыватьОстатки);
	ПараметрыОбнуления.Вставить("ПроводитьДокументы", ОбработкаОбъект.ПроводитьДокументы);
	ПараметрыОбнуления.Вставить("ЛимитСтрокВДокументе", ОбработкаОбъект.ЛимитСтрокВДокументе);
	
	Возврат ОбработкаОбъект.ВыполнитьОбнуление(ПараметрыОбнуления);
	
КонецФункции

#КонецОбласти
